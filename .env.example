# MySQL connection. Use either a single URL...
DATABASE_URL=mysql://root:root@127.0.0.1:3306/portfolio

# ...or the individual vars (DATABASE_URL wins if both are set):
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=root
# MYSQL_DATABASE=portfolio

# Admin login password. Used ONCE by `bun run seed` to create the hashed
# credential in the DB; the app does not read it at runtime.
ADMIN_PASSWORD=change-me
